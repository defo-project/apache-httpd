[Unit]
Description=Socket for uWSGI app %i

[Socket]
ListenStream=/run/uwsgi/%i.socket
SocketUser=www-%i
SocketGroup=www-data
SocketMode=0660

[Install]
WantedBy=sockets.target
+ tee /etc/systemd/system/uwsgi-app@.service
[Unit]
Description=%i uWSGI app
After=syslog.target

[Service]
ExecStart=/usr/bin/uwsgi         --ini /etc/uwsgi/apps-available/%i.ini         --socket /run/uwsgi/%i.socket
User=www-%i
Group=www-data
Restart=on-failure
KillSignal=SIGQUIT
Type=notify
StandardError=file:/var/log/apache2/uwsgi.error.log
StandardOutput=file:/var/log/apache2/uwsgi.log
NotifyAccess=all

[Install]
WantedBy=multi-user.target
